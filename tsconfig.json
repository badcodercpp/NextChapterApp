{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src",
    "src/**/*",
    "src/uniwind-types.d.ts",
    "App.tsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "env.d.ts"
  ],
  "exclude": ["**/node_modules", "**/Pods"]
}
